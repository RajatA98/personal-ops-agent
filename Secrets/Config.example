# Personal Ops Agent — local secrets template
#
# Copy this file to `Secrets/Config.local` (which is gitignored) and fill in real values.
# These values NEVER appear in logs or the repository (Safety Rule #5). At runtime they are
# parsed by `Core.Config`; OAuth tokens themselves move to the iOS Keychain in Phase 2.
#
# Format: KEY=VALUE, one per line. Blank lines and lines starting with `#` are ignored.

# Google OAuth 2.0 client ID from your user-owned Google Cloud project
# (APIs & Services -> Credentials -> OAuth client ID, "Testing" publishing status).
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Gemini (Flash) API key — Google AI Studio.
GEMINI_API_KEY=REPLACE_ME

# ElevenLabs API key — used for cloud text-to-speech (Phase 6).
ELEVENLABS_API_KEY=REPLACE_ME

# CloudKit iPhone<->Mac sync (Phase 7A). OPTIONAL — omit or leave `false` to keep sync OFF
# (the default; the app runs fully local-only). Set to `true` ONLY after following
# docs/CLOUDKIT_SETUP.md: enabling sync needs a PAID Apple Developer account + the iCloud/CloudKit
# capability. Even when `true`, if iCloud is unavailable the app degrades gracefully to local-only.
CLOUDKIT_SYNC_ENABLED=false
